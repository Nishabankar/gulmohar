# HouseDeal CRM env template. Copy to crm/.env (local dev: NODE_ENV=development, PORT=5000, SERVE_FRONTEND=false)
# or crm/.env.hostinger (Hostinger import). Never commit the real values.

# --- Server ---
NODE_ENV=production
PORT=3000

# --- Database (MySQL on Hostinger) ---
DB_HOST=srv1002.hstgr.io
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=change-me
DB_NAME=your_db_name

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@gulmoharcity.in

# --- Websites allowed to call this API (comma-separated) ---
CORS_ORIGIN=https://gulmoharcity.in,https://www.gulmoharcity.in

# --- Express serves the built dashboard from dist/ ---
SERVE_FRONTEND=true

# --- Email (password reset) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@gulmoharcity.in
SMTP_PASS=change-me
SMTP_FROM="Gulmohar City Admin <admin@gulmoharcity.in>"

# --- Dashboard build (read when Hostinger builds the dashboard) ---
VITE_SITE_URL=https://gulmoharcity.in
