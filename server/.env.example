# Copy to server/.env (local) or add these in Hostinger hPanel → Node.js app → Environment variables

NODE_ENV=production
# Hostinger requires port 3000; use 5000 locally (the Vite dev proxy expects it)
PORT=3000

# Hostinger MySQL Database Credentials
DB_HOST=srv1002.hstgr.io
DB_PORT=3306
DB_USER=u660519083_gulmohar
DB_PASSWORD=Housedeal@123
DB_NAME=u660519083_housedealcrm

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h

# Comma-separated allowed origins, e.g. https://gulmoharcity.com,https://www.gulmoharcity.com (empty = allow all)
CORS_ORIGIN=

# true = Express also serves the built React app from ../dist (single Node.js app on Hostinger)
SERVE_FRONTEND=true

# Used only once, to create the default admin when the admins table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@gulmoharcity.com
