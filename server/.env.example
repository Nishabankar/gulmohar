# Copy to server/.env (local) or add these in Hostinger hPanel → Node.js app → Environment variables

NODE_ENV=production
# Hostinger sets PORT automatically; only needed locally
PORT=5000

# MongoDB Atlas → Connect → Drivers → copy the connection string
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/gulmohar_city_db?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h

# Comma-separated allowed origins, e.g. https://gulmoharcity.com,https://www.gulmoharcity.com (empty = allow all)
CORS_ORIGIN=

# true = Express also serves the built React app from ../dist (single Node.js app on Hostinger)
SERVE_FRONTEND=true

# Used only once, to create the first admin when the admins collection is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_EMAIL=admin@gulmoharcity.com
